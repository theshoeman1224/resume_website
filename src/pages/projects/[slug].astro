---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameEmbed from "../../components/GameEmbed.astro";
import { formatProjectDates } from "../../lib/dates";
import { PROJECT_STATUS_LABELS, projectDemoUrl } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const descriptionParagraphs = data.description.split(/\n\s*\n/);
const demoUrl = projectDemoUrl(data, { site: Astro.site, onDetailPage: true });
const dateRange = formatProjectDates(data.dates, data.status === "active");
---

<BaseLayout title={`${data.name} | Josh Shuman`} description={data.summary}>
  <header class="shell project-intro">
    <a class="eyebrow" href="/projects/">Projects / {PROJECT_STATUS_LABELS[data.status]}</a>
    <h1>{data.name}</h1>
    <p>{data.tagline}</p>
    <ul class="chip-list label" aria-label={`Technologies used for ${data.name}`}>
      {data.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="hero-actions">
      {demoUrl && <a class="button button-primary" href={demoUrl}>Open live demo</a>}
      <a class="button" href={data.links.repository}>View source</a>
    </div>
  </header>
  {data.demoAdapter === "snake" && (
    <GameEmbed src="/games/snake/index.html" title="Play Snake, built with Rust and WebAssembly" />
  )}
  <section class="section">
    <div class="shell project-detail-grid">
      <aside class="project-detail-aside">
        <p class="section-index">Project brief</p>
        <p>{data.summary}</p>
        <dl class="project-facts">
          <div><dt class="label">Role</dt><dd>{data.role}</dd></div>
          {dateRange && <div><dt class="label">Dates</dt><dd>{dateRange}</dd></div>}
          <div><dt class="label">Categories</dt><dd>{data.categories.join(" · ")}</dd></div>
          <div><dt class="label">Source</dt><dd><code>{data.source.revision.slice(0, 8)}</code></dd></div>
        </dl>
      </aside>
      <article class="project-copy">
        <h2>Overview</h2>
        {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <h2>Engineering highlights</h2>
        <ul class="project-highlights">
          {data.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
        {(data.links.primary.length > 0 || data.links.dashboards.length > 0) && (
          <>
            <h2>Project links</h2>
            <div class="project-link-groups">
              {data.links.primary.map((link) => <a href={link.url}>{link.name}<span class="label">{link.type}</span></a>)}
              {data.links.dashboards.map((link) => <a href={link.url}>{link.name}<span class="label">{link.type}</span></a>)}
            </div>
          </>
        )}
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .project-intro {
    padding-block: var(--space-intro) var(--space-intro-end);
  }

  .project-intro > .eyebrow {
    text-decoration: none;
  }

  .project-intro h1 {
    max-width: 13ch;
    margin: var(--space-l) 0 var(--space-xl);
    font-size: var(--text-display-xl);
    letter-spacing: -0.035em;
  }

  .project-intro > p {
    max-width: var(--measure);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .project-detail-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.35fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .project-detail-aside {
    color: var(--muted);
  }

  .project-facts {
    margin-top: var(--space-xl);
  }

  .project-facts div {
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--line);
  }

  .project-facts dt {
    color: var(--signal);
  }

  .project-facts dd {
    margin: var(--space-3xs) 0 0;
  }

  .project-copy {
    max-width: var(--measure);
  }

  .project-copy h2 {
    margin: 0 0 var(--space-s);
    padding-top: var(--space-2xl);
    font-size: var(--text-display-m);
    letter-spacing: -0.02em;
  }

  .project-copy h2:first-child {
    padding-top: 0;
  }

  .project-copy p {
    color: var(--muted);
  }

  .project-highlights {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-highlights li {
    position: relative;
    padding: var(--space-s) 0 var(--space-s) var(--space-xl);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .project-highlights li::before {
    position: absolute;
    left: 0;
    color: var(--signal);
    font-family: var(--font-label);
    content: "//";
  }

  .project-link-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs);
  }

  .project-link-groups a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-s);
    border: 1px solid var(--line-strong);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease), color var(--duration-fast) var(--ease);
  }

  .project-link-groups a:hover {
    border-color: var(--signal);
  }

  .project-link-groups span {
    color: var(--muted);
  }

  @media (width < 52rem) {
    .project-detail-grid,
    .project-link-groups {
      grid-template-columns: 1fr;
    }
  }
</style>
