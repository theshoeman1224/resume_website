---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { getCollection } from "astro:content";

const specialties = [
  "Digital signal processing",
  "Systems architecture",
  "Performance engineering",
  "Applied AI",
  "DevSecOps",
];

const featuredProjects = (await getCollection("projects")).filter(({ data }) => data.featured);
---

<BaseLayout
  title="Josh Shuman | Principal Software Engineer"
  description="Principal software engineer working on real-time radar DSP, embedded C, and systems architecture."
>
  <section class="shell hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">Principal Software Engineer</p>
      <h1 id="hero-title">Real-time DSP. Embedded C. <span>Systems that ship.</span></h1>
      <p class="hero-summary">
        Six and a half years from first industry role to principal engineer, keeping radar signal processing on deadline on embedded hardware.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/experience/">Experience</a>
        <a class="button" href="#projects">Projects</a>
      </div>
    </div>
    <div class="hero-aside">
      <p class="status-line label">Focus areas / 05</p>
      <dl>
        {specialties.map((specialty, index) => (
          <div>
            <dt class="label">{String(index + 1).padStart(2, "0")}</dt>
            <dd>{specialty}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="shell">
      <header class="section-heading">
        <p class="section-index">01 / About</p>
        <div>
          <h2 id="about-title">I ship real-time systems that meet their deadlines.</h2>
        </div>
      </header>
      <div class="about-grid">
        <p class="about-copy">
          I've shipped radar DSP software, a new receiver architecture, and an automated photolithography controller presented at AAAS and NCUR. What they share is unforgiving timing and data crossing hardware boundaries at the byte level. Systems like that fail in the field unless robustness and performance are designed in together. I'm looking for principal or lead roles in DSP, embedded, or systems work.
        </p>
        <ul class="principles" aria-label="How I work">
          <li>Profile real-time paths before I touch them</li>
          <li>Define interface contracts before teams depend on them</li>
          <li>Hold user and operator experience to the same standard as my own tools</li>
          <li>Build the dev environments and pipelines I would want to inherit</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="timeline" aria-labelledby="timeline-title">
    <div class="shell">
      <header class="section-heading">
        <p class="section-index">02 / Timeline</p>
        <div>
          <h2 id="timeline-title">What I've built and what it did.</h2>
          <p>Roles, technical decisions, and the outcomes behind them, from 2017 through today.</p>
        </div>
      </header>
      <div class="feature-panel">
        <div>
          <p class="eyebrow">Career record</p>
          <h3>From embedded DSP to principal.</h3>
          <p>The full timeline on the experience page connects each role to the systems it shipped and the decisions that mattered.</p>
        </div>
        <a class="button" href="/experience/#career-timeline">Open the timeline</a>
      </div>
    </div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="shell">
      <header class="section-heading">
        <p class="section-index">03 / Projects</p>
        <div>
          <h2 id="projects-title">Side builds that taught me something.</h2>
          <p>Personal projects where I picked up tools or techniques outside the day job.</p>
        </div>
      </header>
      <ProjectGrid projects={featuredProjects} />
      <div class="section-action"><a class="button" href="/projects/">View all projects</a></div>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-title">
    <div class="shell">
      <header class="section-heading">
        <p class="section-index">04 / Skills</p>
        <div>
          <h2 id="skills-title">What I use daily.</h2>
          <p>The stack I reach for at work, grouped by where it shows up in the system.</p>
        </div>
      </header>
      <div class="skills-grid">
        <article class="skill-group">
          <h3>Build</h3>
          <ul class="skill-list">
            <li>C / C++</li>
            <li>Rust</li>
            <li>Python</li>
            <li>TypeScript</li>
          </ul>
        </article>
        <article class="skill-group">
          <h3>Engineer</h3>
          <ul class="skill-list">
            <li>DSP systems</li>
            <li>Embedded systems</li>
            <li>Performance analysis</li>
            <li>Software architecture</li>
          </ul>
        </article>
        <article class="skill-group">
          <h3>Lead</h3>
          <ul class="skill-list">
            <li>Technical direction</li>
            <li>Engineering mentorship</li>
            <li>DevSecOps</li>
            <li>Applied AI</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="shell">
      <header class="section-heading">
        <p class="section-index">05 / Contact</p>
        <div>
          <h2 id="contact-title">Open to principal or lead roles in DSP, embedded, or systems work.</h2>
          <p>GitHub, LinkedIn, and email are below.</p>
        </div>
      </header>
      <ul class="contact-list">
        <li><a class="contact-link" href="https://github.com/theshoeman1224" rel="me">GitHub / theshoeman1224</a></li>
        <li><a class="contact-link" href="https://www.linkedin.com/in/josh-shuman/" rel="me">LinkedIn / josh-shuman</a></li>
        <li><a class="contact-link" href="mailto:contact@joshshuman.com">Email / contact@joshshuman.com</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.55fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    padding-block: clamp(3rem, 6vw, 5rem) 4rem;
  }

  .status-line {
    color: var(--signal);
  }

  .hero h1 {
    max-width: 13ch;
    margin-bottom: var(--space-xl);
    font-size: var(--text-display-xl);
    letter-spacing: -0.035em;
  }

  .hero h1 span {
    display: block;
    color: var(--signal);
    font-style: italic;
  }

  .hero-summary {
    max-width: var(--measure);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .hero-aside {
    border-top: 1px solid var(--signal);
    padding-top: var(--space-m);
  }

  .hero-aside dl {
    margin: var(--space-xl) 0 0;
  }

  .hero-aside div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--line);
  }

  .hero-aside dt {
    color: var(--muted);
  }

  .hero-aside dd {
    margin: 0;
    text-align: right;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 6rem);
  }

  .about-copy {
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .principles,
  .skill-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles li,
  .skill-list li {
    display: flex;
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--line);
  }

  .principles li::before {
    color: var(--signal);
    font-family: var(--font-label);
    content: "//";
  }

  .feature-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-xl);
    align-items: end;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .feature-panel h3 {
    margin-bottom: var(--space-s);
    font-size: var(--text-display-m);
    letter-spacing: -0.02em;
  }

  .feature-panel p:not(.eyebrow) {
    max-width: var(--measure);
    margin-bottom: 0;
    color: var(--muted);
  }

  .section-action {
    margin-top: var(--space-xl);
    text-align: right;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
  }

  .skill-group {
    padding: var(--space-l);
    border-top: 2px solid var(--signal);
    background: var(--panel);
  }

  .skill-group h3 {
    margin-bottom: var(--space-l);
    font-size: var(--text-display-s);
    letter-spacing: -0.01em;
  }

  .skill-list li {
    color: var(--muted);
  }

  .contact-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 4vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-link {
    display: block;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-lead);
    overflow-wrap: anywhere;
  }

  @media (width < 52rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    .about-grid,
    .contact-list {
      grid-template-columns: 1fr;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (width < 35rem) {
    .feature-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
