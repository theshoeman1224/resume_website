---
import BaseLayout from "../layouts/BaseLayout.astro";
import CareerGlance from "../components/CareerGlance.astro";
import CareerOverview from "../components/CareerOverview.astro";
import CareerRecord from "../components/CareerRecord.astro";
import { getCollection } from "astro:content";
import { careerRelations, findCurrentRole, groupByEmployer, validateCareerGraph } from "../lib/career";
import { buildOverview, serializeOverviewInputs } from "../lib/overview";

const roles = await getCollection("roles");
const accomplishments = await getCollection("accomplishments");
const workProjects = await getCollection("workProjects");

// Fails the build on broken links between roles, accomplishments and work projects.
validateCareerGraph(roles, accomplishments, workProjects);

const groups = groupByEmployer(roles);
const relations = careerRelations(roles, accomplishments, workProjects);
// One "now" for the server render and the browser re-layout, so they match exactly.
const now = new Date();
const overview = buildOverview({ roles, accomplishments, workProjects, now });
const overviewInputs = serializeOverviewInputs({ roles, accomplishments, workProjects, now });
const currentRole = findCurrentRole(roles.filter((role) => role.data.track === "primary"));
const currentGroup = groups.find((group) => group.roles.some(({ role }) => role === currentRole));
const featured = accomplishments
  .filter((win) => win.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Experience | Josh Shuman"
  description="Career record of Josh Shuman: real-time radar signal processing, embedded C, and software architecture at Raytheon, from Software Engineer to Principal."
>
  <header class="shell page-intro">
    <p class="eyebrow">Experience</p>
    <h1 class="page-intro-lead">Principal Software Engineer</h1>
    <p>
      Real-time radar signal processing, embedded C, and the software architecture around them. Every role, project and result below links to the others; each result opens a case study.
    </p>
  </header>

  <div class="shell" data-career>
    {currentRole && <CareerGlance current={currentRole} group={currentGroup} featured={featured} />}

    <section class="career-section" id="timeline" aria-labelledby="overview-title">
      <header class="career-section-head">
        <h2 id="overview-title" class="label">Timeline</h2>
        <p>Roles, work projects and wins on one axis, focused on recent years; earlier years are compressed, not cut. Select any bar or marker to jump to it.</p>
      </header>
      <CareerOverview overview={overview} relations={relations} inputs={overviewInputs} />
    </section>

    <section class="section career-record" id="career-record" aria-labelledby="career-record-title">
      <header class="section-heading">
        <p class="section-index">Career record</p>
        <div>
          <h2 id="career-record-title">Every role, and what shipped under it.</h2>
          <p>Grouped by employer, newest first. Responsibilities held alongside a role sit inside it.</p>
        </div>
      </header>
      <CareerRecord
        groups={groups}
        roles={roles}
        accomplishments={accomplishments}
        workProjects={workProjects}
        relations={relations}
      />
    </section>
  </div>
</BaseLayout>

<script>
  import { initCareerLinks } from "../scripts/career-links";
  import { initCareerOverview } from "../scripts/career-overview";

  document.querySelectorAll<HTMLElement>("[data-overview]").forEach(initCareerOverview);
  document.querySelectorAll<HTMLElement>("[data-career]").forEach(initCareerLinks);
</script>

<style>
  .page-intro h1.page-intro-lead {
    max-width: 100%;
    margin-bottom: var(--space-l);
  }

  .career-section {
    display: none;
    margin-bottom: var(--space-section);
  }

  /* The chart is desktop-only; so is its heading. */
  @media (width >= 52rem) {
    .career-section {
      display: block;
    }
  }

  .career-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-l);
    margin-bottom: var(--space-s);
  }

  .career-section-head h2 {
    margin: 0;
    color: var(--signal);
    font-family: var(--font-label);
  }

  .career-section-head p {
    margin: 0;
    color: var(--muted);
  }

  /* The record's .section rule spans the shell, not the viewport, inside this wrapper. */
  .career-record {
    padding-top: var(--space-section);
  }
</style>
