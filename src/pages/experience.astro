---
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
import { getCollection } from "astro:content";

const roles = await getCollection("roles");
const accomplishments = await getCollection("accomplishments");

const roleSlugs = new Set(roles.map((role) => role.id.replace(/\.md$/, "")));
const accomplishmentSlugs = new Set(
  accomplishments.map((entry) => entry.id.replace(/\.md$/, "")),
);

for (const role of roles) {
  const slug = role.id.replace(/\.md$/, "");
  for (const accSlug of role.data.accomplishments) {
    if (!accomplishmentSlugs.has(accSlug)) {
      console.warn(
        `[experience] role "${slug}" references missing accomplishment "${accSlug}".`,
      );
    }
  }
}

for (const entry of accomplishments) {
  const slug = entry.id.replace(/\.md$/, "");
  if (!roleSlugs.has(entry.data.roleId)) {
    console.warn(
      `[experience] accomplishment "${slug}" has roleId "${entry.data.roleId}" which does not match any role.`,
    );
  }
  for (const rel of entry.data.relatedRoles) {
    if (!roleSlugs.has(rel)) {
      console.warn(
        `[experience] accomplishment "${slug}" references missing related role "${rel}".`,
      );
    }
  }
}
---

<BaseLayout
  title="Experience | Josh Shuman"
  description="Principal Software Engineer leading performant systems for the customer and the program, accountable for the technical direction behind them."
>
  <header class="shell page-intro">
    <p class="eyebrow">Experience</p>
    <h1 class="page-intro-lead">
      Principal Software Engineer
      <span class="page-intro-subtitle">leading performant systems for the customer and the program, accountable for the technical direction behind them.</span>
    </h1>
  </header>

  <section class="section" id="career-timeline" aria-labelledby="career-record-title">
    <div class="shell">
      <header class="section-heading">
        <p class="section-index">Career record</p>
        <div>
          <h2 id="career-record-title">Roles and what shipped under them.</h2>
          <p>Click a role to see the work behind it. Filter by discipline at the top.</p>
        </div>
      </header>
      <Timeline roles={roles} accomplishments={accomplishments} />
    </div>
  </section>
</BaseLayout>
