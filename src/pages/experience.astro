---
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
import { getCollection } from "astro:content";

const accomplishments = (await getCollection("accomplishments")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Experience | Josh Shuman"
  description="Engineering experience and focus areas for Josh Shuman, Principal Software Engineer."
>
  <header class="shell page-intro">
    <p class="eyebrow">Experience / Overview</p>
    <h1>Technical range. Focused outcomes.</h1>
    <p>
      A career centered on performance-sensitive software, systems architecture, and technical leadership. The record below connects role progression to concrete technical contributions.
    </p>
  </header>

  <section class="section" aria-labelledby="focus-title">
    <div class="shell">
      <header class="section-heading">
        <p class="section-index">Current focus</p>
        <div>
          <h2 id="focus-title">How I contribute.</h2>
          <p>Three connected modes of engineering work, from implementation detail to organizational direction.</p>
        </div>
      </header>
      <div class="focus-grid">
        <article class="focus-card">
          <span>01 / Performance</span>
          <h2>Make critical paths measurable.</h2>
          <p>Profile systems, identify meaningful constraints, and turn findings into reliable implementation improvements.</p>
        </article>
        <article class="focus-card">
          <span>02 / Architecture</span>
          <h2>Build for change without guessing.</h2>
          <p>Define clear boundaries and pragmatic designs that serve today's requirements without blocking tomorrow's work.</p>
        </article>
        <article class="focus-card">
          <span>03 / Leadership</span>
          <h2>Increase engineering leverage.</h2>
          <p>Set technical direction, communicate tradeoffs, and help teams deliver dependable systems with confidence.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="career-timeline" aria-labelledby="accomplishments-title">
    <div class="shell">
      <header class="section-heading">
        <p class="section-index">Career record</p>
        <div>
          <h2 id="accomplishments-title">Selected accomplishments.</h2>
          <p>Filter the reverse-chronological record by discipline, then expand a milestone to inspect its impact and technical context.</p>
        </div>
      </header>
      <Timeline accomplishments={accomplishments} />
    </div>
  </section>
</BaseLayout>
