---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Josh Shuman"
  description="The requested page could not be found on Josh Shuman's engineering portfolio."
>
  <section class="shell error-page" aria-labelledby="error-title">
    <div>
      <p class="eyebrow">Error / 404</p>
      <h1 id="error-title">Signal lost.</h1>
      <p>The requested route does not exist or may have moved. Return to the portfolio or continue to the project index.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Return home</a>
        <a class="button" href="/projects/">Browse projects</a>
      </div>
    </div>
    <p class="error-code" aria-hidden="true">404</p>
  </section>
</BaseLayout>

<style>
  .error-code {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.08;
    text-wrap: balance;
  }

  .error-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: center;
    min-height: calc(100svh - 9rem);
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .error-page h1 {
    margin-bottom: 2rem;
    font-size: var(--text-display-xl);
    letter-spacing: -0.035em;
  }

  .error-page > div > p:not(.eyebrow) {
    max-width: var(--measure);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .error-code {
    margin: 0;
    color: transparent;
    font-size: clamp(8rem, 24vw, 22rem);
    line-height: 0.75;
    -webkit-text-stroke: 1px var(--line);
  }

  @media (max-width: 52rem) {
    .error-page {
      grid-template-columns: 1fr;
    }

    .error-code {
      display: none;
    }
  }
</style>
