---
import type { CollectionEntry } from "astro:content";

interface Props {
  accomplishment: CollectionEntry<"accomplishments">;
}

const { accomplishment } = Astro.props;
const { id, data } = accomplishment;
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const startDate = dateFormatter.format(data.date);
const endDate = data.endDate ? dateFormatter.format(data.endDate) : "Present";
const roleTypeLabels = {
  primary: "Core role",
  leadership: "Leadership role",
  initiative: "Concurrent initiative",
};
---

<li class="timeline-item" data-timeline-item data-category={data.category}>
  <div class="timeline-marker" aria-hidden="true"></div>
  <details class="timeline-entry" id={id.replace(/\.md$/, "")}>
    <summary>
      <span class="timeline-date">{startDate} - {endDate}</span>
      <span class="timeline-category">{data.category}</span>
      <span class="timeline-role">{data.role} / {data.organization}</span>
      <span class="timeline-title">{data.title}</span>
      <span class="timeline-summary">{data.summary}</span>
      <span class="timeline-prompt" aria-hidden="true">Inspect milestone</span>
    </summary>
    <div class="timeline-details">
      <p class="timeline-track">{roleTypeLabels[data.roleType]}</p>
      <p><strong>Impact</strong>{data.impact}</p>
      <div>
        <strong>Technical context</strong>
        <ul class="technology-list" aria-label={`Technologies used for ${data.title}`}>
          {data.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </div>
    </div>
  </details>
</li>
