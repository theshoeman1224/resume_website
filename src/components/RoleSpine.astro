---
import type { CollectionEntry } from "astro:content";
import RoleNode from "./RoleNode.astro";
import { spinePosition, spreadPositions, yearMarkers } from "../lib/spine";

interface Props {
  items: { role: CollectionEntry<"roles">; categories: string[] }[];
}

/** Closest two role markers may sit, as a percentage of the spine width. */
const MIN_MARKER_GAP = 2.5;
/** A year label is dropped when a below-axis marker is this close (its tab line would cross it). */
const YEAR_LABEL_CLEARANCE = 2.5;

const { items } = Astro.props;
const buildTime = new Date();
const rangeStart = new Date(Math.min(...items.map(({ role }) => role.data.startDate.valueOf())));
const rangeEnd = new Date(
  Math.max(...items.map(({ role }) => (role.data.endDate ?? buildTime).valueOf())),
);

const positions = spreadPositions(
  items.map(({ role }) => spinePosition(role.data.startDate, rangeStart, rangeEnd)),
  MIN_MARKER_GAP,
);
const sides = items.map((_, index) => (index % 2 === 0 ? "above" : "below") as "above" | "below");
const years = yearMarkers(
  rangeStart,
  rangeEnd,
  positions.filter((_, index) => sides[index] === "below"),
  YEAR_LABEL_CLEARANCE,
);
---

<div class="timeline-spine" data-timeline-spine>
  <div class="timeline-axis" aria-hidden="true"></div>
  <ol class="timeline-years" aria-hidden="true">
    {years.map(({ year, position, labelled }) => (
      <li style={`--x: ${position}%`}>{labelled && <span class="label">{year}</span>}</li>
    ))}
  </ol>
  <span class="timeline-connector" aria-hidden="true"></span>
  <div class="timeline-nodes" role="toolbar" aria-label="Career roles">
    {items.map(({ role, categories }, index) => (
      <RoleNode role={role} categories={categories} position={positions[index]} side={sides[index]} />
    ))}
  </div>
</div>

<style>
  .timeline-spine {
    display: none;
  }

  @media (width >= 52rem) {
    :global(.js) .timeline-spine {
      /* Room for the tallest label above and below the axis. */
      --spine-above: 7.75rem;
      --spine-below: 9rem;
      --axis-y: var(--spine-above);

      display: block;
      position: relative;
      height: calc(var(--spine-above) + var(--spine-below));
      margin-inline: var(--space-3xs);
    }
  }

  .timeline-axis {
    position: absolute;
    top: var(--axis-y);
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }

  .timeline-years {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-years li {
    position: absolute;
    top: var(--axis-y);
    left: var(--x);
    width: 1px;
    height: var(--space-2xs);
    background: var(--line-strong);
  }

  .timeline-years span {
    position: absolute;
    top: var(--space-xs);
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* Runs from the selected marker down into the open panel. */
  .timeline-connector {
    position: absolute;
    top: var(--axis-y);
    bottom: calc(-1 * var(--timeline-panel-gap));
    left: var(--selected-x, 50%);
    width: 1px;
    background: var(--signal);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
    transition: opacity var(--duration-fast) var(--ease);
  }

  .timeline-spine[data-selected] .timeline-connector {
    opacity: 1;
  }

  .timeline-nodes {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
  }
</style>
