---
import type { Overview } from "../lib/overview";

interface Props {
  overview: Overview;
  /** Keys related to each key; see careerRelations in src/lib/career.ts. */
  relations: Map<string, string[]>;
}

const { overview, relations } = Astro.props;
const related = (key: string) => (relations.get(key) ?? []).join(" ");
---

<!--
  Every bar and marker is a plain link to its entry in the career record below,
  so the chart works without JS. src/scripts/career-links.ts adds highlighting.
-->
<nav class="overview" aria-label="Career overview">
  <div class="overview-grid" aria-hidden="true">
    {overview.years.map(({ position }) => <span style={`--x: ${position}%`}></span>)}
    <span class="overview-now" style={`--x: ${overview.now}%`}></span>
  </div>

  {overview.lanes.map((lane) => (
    <div class="overview-lane" data-style={lane.style} style={`--rows: ${lane.rows}`}>
      <p class="overview-lane-label label">{lane.label}</p>
      <ul class="overview-track">
        {lane.items.map((item) => (
          <li
            class="overview-item"
            data-kind={item.kind}
            data-point={item.point ? "" : undefined}
            data-ongoing={item.ongoing ? "" : undefined}
            data-flip={item.flip ? "" : undefined}
            data-compact={item.compact ? "" : undefined}
            style={`--start: ${item.start}%; --end: ${item.end}%; --row: ${item.row}`}
          >
            <a href={`#${item.key}`} title={item.description} data-key={item.key} data-related={related(item.key)}>
              <span class="overview-marker" aria-hidden="true"></span>
              <span class="overview-label label" aria-hidden="true">{item.label}</span>
              <span class="visually-hidden">{item.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="overview-lane overview-axis" aria-hidden="true">
    <span></span>
    <ol class="overview-track">
      {overview.years.map(({ year, position }) => (
        <li class="label" style={`--x: ${position}%`}>{year}</li>
      ))}
      <li class="label overview-axis-now" style={`--x: ${overview.now}%`}>Now</li>
    </ol>
  </div>
</nav>

<style>
  .overview {
    --label-column: 9rem;
    --bar-row: 2rem;
    --win-row: 1.875rem;

    display: none;
    position: relative;
    grid-template-columns: var(--label-column) minmax(0, 1fr);
    row-gap: var(--space-xs);
    padding: var(--space-l) var(--space-l) var(--space-s);
    border: 1px solid var(--line);
    background: var(--panel);
  }

  /* The record below carries everything on narrow screens. */
  @media (width >= 52rem) {
    .overview {
      display: grid;
    }
  }

  /* Year gridlines behind every lane, aligned with the tracks. */
  .overview-grid {
    position: absolute;
    top: var(--space-l);
    right: var(--space-l);
    bottom: var(--space-s);
    left: calc(var(--space-l) + var(--label-column));
    pointer-events: none;
  }

  .overview-grid span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 1px;
    background: var(--line);
    opacity: 0.6;
  }

  .overview-grid .overview-now {
    background: var(--signal);
    opacity: 0.45;
  }

  .overview-lane {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: start;
  }

  .overview-lane-label {
    margin: 0;
    padding-top: 0.4rem;
    padding-right: var(--space-s);
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .overview-track {
    position: relative;
    height: calc(var(--rows) * var(--bar-row));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .overview-lane[data-style="wins"] .overview-track {
    height: calc(var(--rows) * var(--win-row));
  }

  .overview-item {
    position: absolute;
    top: calc(var(--row) * var(--bar-row));
    left: var(--start);
    width: calc(var(--end) - var(--start));
    height: calc(var(--bar-row) - 0.375rem);
    transition: opacity var(--duration-fast) var(--ease);
  }

  .overview-item a {
    display: flex;
    align-items: center;
    height: 100%;
    text-decoration: none;
  }

  /* Bars: the marker is the bar, the label sits inside it. */
  .overview-lane[data-style="bars"] .overview-item a {
    position: relative;
    margin-right: 2px;
    padding-inline: var(--space-2xs);
    overflow: hidden;
  }

  .overview-lane[data-style="bars"] .overview-marker {
    position: absolute;
    inset: 0;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    transition: border-color var(--duration-fast) var(--ease), background var(--duration-fast) var(--ease);
  }

  .overview-lane[data-style="bars"] .overview-label {
    position: relative;
    overflow: hidden;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .overview-item[data-compact] .overview-label {
    display: none;
  }

  .overview-item[data-kind="role"] .overview-marker {
    border-color: var(--signal);
    background: var(--signal-soft);
  }

  .overview-item[data-kind="current"] .overview-marker {
    border-color: var(--signal);
    background: var(--signal);
  }

  .overview-item[data-kind="current"] .overview-label {
    color: var(--on-signal);
  }

  .overview-item[data-kind="concurrent"] .overview-marker {
    border-style: dashed;
    border-color: var(--signal);
    background: transparent;
  }

  .overview-item[data-kind="education"] .overview-marker {
    border-color: var(--ink);
    background: transparent;
  }

  .overview-item[data-kind="project"] .overview-label {
    color: var(--muted);
  }

  /* An ongoing bar fades out past "now" instead of ending at the chart's edge. */
  .overview-item[data-ongoing] .overview-marker {
    border-right: 0;
    mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
  }

  /* Wins: a dot (or a thin line for a span) with its label beside it. */
  .overview-lane[data-style="wins"] .overview-item {
    top: calc(var(--row) * var(--win-row));
    height: calc(var(--win-row) - 0.25rem);
  }

  .overview-lane[data-style="wins"] .overview-item a {
    position: relative;
    gap: var(--space-2xs);
    width: max-content;
    min-width: 100%;
    margin-left: -0.3125rem;
  }

  .overview-lane[data-style="wins"] .overview-marker {
    flex-shrink: 0;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--signal);
  }

  .overview-item[data-kind="win"]:not([data-point]) .overview-marker {
    position: absolute;
    left: 0.3125rem;
    width: calc(100% - 0.3125rem);
    height: 3px;
    bottom: 0;
    border-radius: 0;
    background: color-mix(in srgb, var(--signal) 55%, transparent);
  }

  .overview-item[data-kind="win"]:not([data-point]) .overview-label {
    padding-left: 0.3125rem;
  }

  /* Near the right edge the label sits left of the marker, anchored at the marker. */
  .overview-lane[data-style="wins"] .overview-item[data-flip] a {
    position: absolute;
    right: -0.3125rem;
    flex-direction: row-reverse;
    margin-left: 0;
  }

  .overview-item[data-kind="win"][data-flip]:not([data-point]) a {
    right: 0;
  }

  .overview-item[data-kind="win"][data-flip]:not([data-point]) .overview-label {
    padding-left: 0;
    padding-right: 0.3125rem;
  }

  .overview-lane[data-style="wins"] .overview-label {
    color: var(--ink);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* Hover and focus: the related items stay bright, everything else steps back. */
  .overview-item a:hover .overview-marker,
  .overview-item a:focus-visible .overview-marker,
  .overview-item:has([data-lit]) .overview-marker {
    border-color: var(--ink);
  }

  .overview:has([data-lit]) .overview-item:not(:has([data-lit])) {
    opacity: 0.3;
  }

  .overview-item a:focus-visible {
    outline-offset: 2px;
  }

  .overview-axis {
    padding-top: var(--space-3xs);
  }

  .overview-axis .overview-track {
    height: 2.5rem;
  }

  .overview-axis li {
    position: absolute;
    left: var(--x);
    transform: translateX(-50%);
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .overview-axis .overview-axis-now {
    top: 1.1rem;
    color: var(--signal);
  }

</style>
