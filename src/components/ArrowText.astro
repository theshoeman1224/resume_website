---
import Arrow from "./Arrow.astro";

// Renders content text such as "7–10% → 1–2%" with drawn arrows. Screen
// readers hear "7–10% to 1–2%". Lines break only at spaces, never at a dash,
// and an arrow stays with the word after it: a wrap reads "7–10%" / "→ 1–2%"
// (never "7–" / "10%"), and "6 months early" can wrap between its words.
interface Props {
  text: string;
}

const words = (text: string) => text.split(/\s+/).filter(Boolean);

// Odd indexes are the arrows themselves (the capture group).
const [first, ...rest] = Astro.props.text.split(/\s*([→←])\s*/);
const chunks: { arrow?: string; text: string }[] = words(first).map((text) => ({ text }));
for (let index = 0; index < rest.length; index += 2) {
  const [head = "", ...tail] = words(rest[index + 1] ?? "");
  chunks.push({ arrow: rest[index], text: head }, ...tail.map((text) => ({ text })));
}
---

{chunks.map(({ arrow, text }, index) => (
  <>{index > 0 && " "}<span class="word">{arrow && (
    <><Arrow direction={arrow === "←" ? "left" : "right"} /><span class="visually-hidden"> {arrow === "←" ? "from" : "to"} </span></>
  )}{text}</span></>
))}

<style>
  .word {
    white-space: nowrap;
  }

  /* The space before the arrow does the spacing (and vanishes at a line break), so no margin before it. */
  .word > :global(.arrow:first-child) {
    margin-inline-start: 0;
  }
</style>
