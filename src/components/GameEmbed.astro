---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<section class="game-embed-section" id="play" aria-labelledby="game-demo-title">
  <div class="shell">
    <header class="section-heading">
      <p class="section-index">Interactive demo</p>
      <div>
        <h2 id="game-demo-title">Play the WebAssembly build.</h2>
        <p>Choose a difficulty to start. Move with Arrow keys or WASD, pause at any time, and use Restart to reset the current mode. Touch controls are included.</p>
      </div>
    </header>
    <div class="game-frame-shell">
      <iframe
        class="game-frame"
        data-game-frame
        src={src}
        title={title}
        loading="eager"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLIFrameElement>("[data-game-frame]").forEach((frame) => {
    let lastWidth = 0;
    let contentObserver: ResizeObserver | undefined;

    const resizeToContent = () => {
      const embeddedDocument = frame.contentDocument;
      const body = embeddedDocument?.body;
      if (!body) return;

      const contentBottom = Array.from(body.children).reduce(
        (bottom, element) => Math.max(bottom, element.getBoundingClientRect().bottom),
        0,
      );
      frame.style.height = `${Math.ceil(contentBottom)}px`;
    };

    const handleLoad = () => {
      const body = frame.contentDocument?.body;
      if (!body) return;

      contentObserver?.disconnect();
      contentObserver = new ResizeObserver(resizeToContent);
      body.querySelectorAll("*").forEach((element) => contentObserver?.observe(element));
      resizeToContent();
      frame.contentDocument?.fonts.ready.then(resizeToContent);
    };

    frame.addEventListener("load", handleLoad);
    if (frame.contentDocument?.readyState === "complete") handleLoad();

    new ResizeObserver(([entry]) => {
      const width = entry.contentRect.width;
      if (width === lastWidth) return;
      lastWidth = width;
      resizeToContent();
    }).observe(frame);
  });
</script>
