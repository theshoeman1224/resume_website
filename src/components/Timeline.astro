---
import type { CollectionEntry } from "astro:content";
import RoleDetail from "./RoleDetail.astro";
import RoleSpine from "./RoleSpine.astro";
import TimelineFilters from "./TimelineFilters.astro";
import {
  accomplishmentsForRole,
  byId,
  roleCategories,
  roleLinks,
  sortRolesNewestFirst,
  uniqueSorted,
} from "../lib/career";

interface Props {
  roles: CollectionEntry<"roles">[];
  accomplishments: CollectionEntry<"accomplishments">[];
}

const roles = sortRolesNewestFirst(Astro.props.roles);
const { accomplishments } = Astro.props;
const rolesById = byId(roles);
const accomplishmentsById = byId(accomplishments);
const categories = uniqueSorted(accomplishments.map(({ data }) => data.category));

const items = roles.map((role) => ({
  role,
  categories: roleCategories(role, accomplishmentsById),
  accomplishments: accomplishmentsForRole(role, accomplishmentsById).map((entry) => ({
    entry,
    relatedRoles: roleLinks(entry.data.relatedRoles, rolesById),
  })),
}));
---

<!--
  One <details> per role serves both layouts. On wide screens (with JS) the
  summaries are hidden, the spine buttons open them, and the open one shows as
  the panel under the spine. Without JS, or on narrow screens, they are a
  plain expandable list.
-->
<div class="timeline" data-timeline>
  <TimelineFilters categories={categories} total={roles.length} />
  <RoleSpine items={items} />
  <div class="role-details">
    {items.map((item) => (
      <RoleDetail role={item.role} categories={item.categories} accomplishments={item.accomplishments} />
    ))}
  </div>
</div>

<style>
  .timeline {
    /* Space between the spine and the open role panel; the connector spans it. */
    --timeline-panel-gap: var(--space-xl);
  }

  .role-details {
    display: grid;
    gap: var(--space-xs);
  }

  @media (width >= 52rem) {
    :global(.js) .role-details {
      display: block;
      margin-top: var(--timeline-panel-gap);
    }
  }
</style>

<script>
  import { initTimeline } from "../scripts/timeline";

  document.querySelectorAll<HTMLElement>("[data-timeline]").forEach(initTimeline);
</script>
