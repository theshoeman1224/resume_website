---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { data } = Astro.props.project;
const statusLabels = {
  active: "Active",
  complete: "Complete",
  experimental: "Experimental",
  prototype: "Prototype",
  archived: "Archived",
};
const demoUrl = data.demoAdapter === "snake"
  ? `/projects/${data.slug}/#play`
  : data.demo.type === "external"
    ? data.demo.url
    : undefined;
---

<article class="project-card">
  <a class="project-visual" href={`/projects/${data.slug}/`} tabindex="-1" aria-hidden="true">
    {data.image ? (
      <img src={data.image.src} alt={data.image.alt} loading="lazy" />
    ) : (
      <span>{data.technologies.slice(0, 2).join(" / ")}</span>
    )}
  </a>
  <div class="project-card-content">
    <div class="project-card-meta">
      <span>{statusLabels[data.status]}</span>
      <span>{String(data.technologies.length).padStart(2, "0")} technologies</span>
    </div>
    <h3><a href={`/projects/${data.slug}/`}>{data.name}</a></h3>
    <p>{data.summary}</p>
    <ul class="technology-list" aria-label={`Technologies used for ${data.name}`}>
      {data.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="project-card-actions">
      <a href={`/projects/${data.slug}/`}>View details</a>
      {demoUrl && <a href={demoUrl}>Live demo</a>}
      <a href={data.links.repository}>GitHub</a>
    </div>
  </div>
</article>
