---
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL("/social-preview.png", Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Lets CSS switch to script-driven layouts (the timeline spine) without a flash. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101311" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Josh Shuman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Josh Shuman, Principal Software Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Josh Shuman <span aria-hidden="true">/</span> Principal Software Engineer</p>
        <p>Designed and built as a fast, static Astro site.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 500;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .footer-inner p {
    margin: 0;
  }

  @media (width < 35rem) {
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
