{
  "name": "resume-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync:portfolio && astro dev",
    "build": "npm run sync:portfolio && npm run build:site",
    "build:site": "astro check && astro build",
    "build:snake": "./scripts/build-snake.sh",
    "preview": "astro preview",
    "check": "npm run sync:portfolio && astro check",
    "sync:portfolio": "node ./scripts/sync-portfolio-metadata.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.120.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  }
}
